# Salin ke .env lalu isi. .env diabaikan git; jangan pernah meng-commit rahasia asli.

# --- Backend (prefix HAST_) -------------------------------------------------
HAST_ENVIRONMENT=production
# String acak yang panjang, mis.  python -c "import secrets; print(secrets.token_urlsafe(48))"
HAST_JWT_SECRET=
HAST_JWT_EXPIRE_MINUTES=480
# Akun Administrator pertama, hanya dibuat ketika tabel pengguna masih kosong.
HAST_ADMIN_USERNAME=
HAST_ADMIN_PASSWORD=
# Bawaan: sqlite:///<repo>/database/database.db   (PostgreSQL: postgresql+psycopg://user:pass@host/db)
# HAST_DATABASE_URL=
HAST_MAX_UPLOAD_MB=50

# --- SonarQube API (opsional, dipakai tools/convert_sonar_to_cwe) ------------
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=

# --- Frontend -----------------------------------------------------------------
API_BASE_URL=http://127.0.0.1:8000
# Alamat API yang dapat dijangkau peramban (tautan unduhan laporan sampel).
# Lokal: kosongkan (memakai API_BASE_URL). Di balik reverse proxy: https://<domain-anda>.
PUBLIC_API_BASE_URL=
